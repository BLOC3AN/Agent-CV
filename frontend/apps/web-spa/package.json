{
  "name": "@hr/web-spa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-3000} tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hr/schema": "*",
    "@hr/templates": "*",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3"
  }
}

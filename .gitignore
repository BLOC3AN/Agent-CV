# Dữ liệu thật — CV/JD chứa PII, KHÔNG commit (TDD §15)
# LƯU Ý: gitignore KHÔNG hỗ trợ comment cuối dòng. Comment phải ở dòng riêng,
# nếu không phần "# ..." bị tính là một phần của pattern và rule mất tác dụng.
eval/cv/*.pdf
eval/cv/*.png
eval/cv/*.docx
# ánh xạ mã ẩn danh → tên thật
eval/cv/.filemap.txt
eval/jd/*.txt
# nhãn golden dẫn xuất từ CV thật cũng chứa PII
eval/golden/*.json
!eval/**/.gitkeep
!eval/**/README.md
# INVENTORY.md chỉ mô tả cấu trúc, KHÔNG chứa PII
!eval/cv/INVENTORY.md
backend/legacy-eval/cv/*.pdf
backend/legacy-eval/cv/*.png
backend/legacy-eval/cv/*.docx
backend/legacy-eval/cv/.filemap.txt
backend/legacy-eval/golden/*.json
backend/bin/

# Ghi chú đánh giá thủ công có thể chứa trích đoạn CV
eval/manual-log.md

# ── File upload của user — CHỨA CV THẬT, tuyệt đối không commit (TDD §15) ──
storage/
var/
# Docker bind-mounted PostgreSQL, Redis and user-upload data — local PII/state.
data-deploy/
# Thư mục tạm của test e2e
.tmp/

# Python bytecode của services/pdfkit
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

*.log
.DS_Store

# Thư mục làm việc của subagent-driven-development — scratch, không phải mã nguồn
.superpowers/

# Worktree cô lập do Claude Code tạo — không bao giờ commit
.claude/worktrees/

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowJs": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@hr/schema": [
        "../../packages/schema/src/index.ts"
      ],
      "@hr/templates": [
        "../../packages/templates/src/index.ts"
      ],
      "@hr/db": [
        "../../packages/db/src/index.ts"
      ],
      "@hr/ai": [
        "../../packages/ai/src/index.ts"
      ],
      "@hr/pdf": [
        "../../packages/pdf/src/index.ts"
      ],
      "@hr/worker/queues": [
        "../../services/worker/src/queues.ts"
      ],
      "@hr/worker/storage": [
        "../../services/worker/src/storage.ts"
      ]
    },
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

{
  "name": "hr-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "eval": "tsx eval/run.ts",
    "clean": "tsc --build --clean && rm -rf packages/*/dist",
    "db:migrate": "tsx db/migrate.ts",
    "db:reset": "docker compose down -v postgres && docker compose up -d postgres && sleep 8 && npm run db:migrate",
    "dev:restart": "bash scripts/dev-restart.sh",
    "build:web": "cd apps/web && next build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "fast-json-patch": "^3.1.1",
    "next": "^15.5.22",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.14"
  }
}

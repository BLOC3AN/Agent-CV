{
  "name": "hr-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "npm run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck:core && npm run typecheck:web",
    "typecheck:core": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run --project unit --project ui",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "eval": "tsx eval/run.ts",
    "clean": "tsc --build --clean && rm -rf packages/*/dist",
    "db:migrate": "tsx db/migrate.ts",
    "db:reset": "docker compose down -v postgres && docker compose up -d postgres && sleep 8 && npm run db:migrate",
    "dev:restart": "bash scripts/dev-restart.sh",
    "build:web": "cd apps/web && next build",
    "kb:ingest": "tsx scripts/kb-ingest.ts",
    "test:ui": "vitest run --project ui"
  },
  "//devDependencies": "Chỉ công cụ dùng chung cho cả repo: bộ chạy test, kiểu, tsx. Dependency RUNTIME thuộc về workspace dùng nó — khai ở đây thì workspace sống nhờ hoisting, và bản build Docker của riêng nó sẽ thiếu package.",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.23",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^20.11.1",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.1.8"
  }
}

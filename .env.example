BACKEND_ADDR=:8080
DATABASE_URL=postgres://postgres:hragent_dev@localhost:5433/hragent
REDIS_URL=redis://localhost:6380
MODEL_HOST=http://100.68.50.41
AUTH_SECRET=change-me
GO_API_CUTOVER=false
BACKEND_URL=http://localhost:8080

# Gốc của ứng dụng phía người dùng, KHÔNG có dấu / cuối. Quyết định ba thứ:
# `redirect_uri` gửi sang Google, đích redirect sau khi đăng nhập, và cờ Secure
# của cookie khi giá trị bắt đầu bằng https://.
# BẮT BUỘC: không đặt thì /api/auth/google/start trả 503 thay vì âm thầm gửi
# Google một redirect_uri localhost (Google đáp redirect_uri_mismatch).
APP_BASE_URL=http://localhost:3000

# ── Magic link — đường đăng nhập của DEV, mặc định TẮT ──────────────────────
# Repo không có mailer: /api/auth/request không gửi được thư, nó chỉ trả về
# `devLink` chứa token thô. Nghĩa là bất kỳ ai gọi được endpoint này cũng đăng
# nhập được vào BẤT KỲ tài khoản nào.
# Cổng hỏng-ĐÓNG: chỉ đúng chuỗi "true" mới mở; không đặt, gõ sai, hay giá trị
# lạ đều là đóng. KHÔNG đặt biến này ở production.
MAGIC_LINK_DEV=true

# Đăng nhập Google (OAuth 2.0 Authorization Code).
# redirect_uri phải đăng ký trong Google Cloud Console ĐÚNG Y HỆT:
#   ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CHỈ để test tiêm được endpoint của Google. ĐỂ TRỐNG.
# Đặt giá trị nghĩa là chuyển cả bước đổi code — kèm GOOGLE_CLIENT_SECRET —
# sang một host của bên thứ ba. TUYỆT ĐỐI không đặt ở production.
GOOGLE_OAUTH_BASE=

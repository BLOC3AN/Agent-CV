# HR-Agent — biến môi trường (TDD §12.2)
# Sao chép thành .env rồi điền. KHÔNG commit .env.

# ── Hạ tầng cục bộ (docker-compose) ─────────────────────────────────────────
PG_PASSWORD=hragent_dev
DATABASE_URL=postgres://postgres:hragent_dev@localhost:5433/hragent
REDIS_URL=redis://localhost:6380
PDFKIT_URL=http://localhost:8100

# ── Model server — dependency NGOÀI, chỉ đọc, qua Tailscale ─────────────────
# Ports: 5010 generalist · 5011 reasoner · 5012 ocr · 5013 classifier
#        5014 reranker   · 8003 embedder
MODEL_HOST=http://100.68.50.41

# ── Ứng dụng ────────────────────────────────────────────────────────────────
AUTH_SECRET=
STORAGE_DRIVER=local
# PHẢI tuyệt đối: web (`next start` trong apps/web) và worker (gốc repo) có
# thư mục làm việc khác nhau — đường dẫn tương đối cho ra hai thư mục khác nhau
# và worker sẽ báo FILE_MISSING với mọi file web vừa lưu.
STORAGE_ROOT=/duong/dan/tuyet/doi/var/storage
NODE_ENV=development

# ── Cloud — TẮT ở giai đoạn 1, chi phí LLM = $0 ─────────────────────────────
# Bật sau gọi vốn: đặt providers.anthropic.enabled: true trong config.yml
# rồi điền key ở đây. KHÔNG cần sửa code nghiệp vụ.
ANTHROPIC_API_KEY=

# ── Ghi đè config (tuỳ chọn) ────────────────────────────────────────────────
# HR_CONFIG_PATH=/duong/dan/khac/config.yml

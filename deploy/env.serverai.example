# Mẫu .env production cho Server AI (staging-master).
#
# Bản THẬT nằm ở /opt/hr-agent/.env trên Server AI và KHÔNG BAO GIỜ vào git.
# File này chỉ mô tả những khoá cần có; mọi giá trị bí mật để trống.

# ── Định danh công khai ─────────────────────────────────────────────────────
# Quyết định ba thứ: redirect_uri gửi sang Google, đích redirect sau đăng nhập,
# và cờ Secure của cookie (bật khi giá trị bắt đầu bằng https://).
APP_BASE_URL=https://cvguide.site
NODE_ENV=production

# ── Bí mật — sinh ngẫu nhiên, không tái sử dụng giữa các môi trường ─────────
PG_PASSWORD=
AUTH_SECRET=

# ── Google OAuth ────────────────────────────────────────────────────────────
# redirect_uri phải khớp Y HỆT: ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# CHỈ để test tiêm được endpoint của Google. ĐỂ TRỐNG ở production.
GOOGLE_OAUTH_BASE=

# ── MAGIC_LINK_DEV: KHÔNG đặt biến này ─────────────────────────────────────
# Repo không có mailer, nên /api/auth/request trả thẳng token thô trong
# response. Mở cổng này ở production nghĩa là bất kỳ ai gọi được endpoint đó
# cũng đăng nhập được vào BẤT KỲ tài khoản nào. Cổng hỏng-đóng: chỉ đúng chuỗi
# "true" mới mở, nên cách an toàn nhất là không viết dòng nào cả.

# ── Model ───────────────────────────────────────────────────────────────────
# Chính là máy đang chạy compose này (IP Tailscale của staging-master).
# Container gọi ra host qua địa chỉ này bình thường.
MODEL_HOST=http://100.68.50.41

# ── Key cloud cho trình chọn model trong chat ──────────────────────────────
# ChatPanel.tsx:25-27 chào ba lựa chọn:
#   Neura Flash → local.reasoner  (chạy trên máy này, không cần key)
#   Neura Plus  → deepseek.v4     → DEEPSEEK_API_KEY
#   Neura Pro   → openai.luna     → OPENAI_API_KEY
#
# Thiếu key thì CHỈ hai lựa chọn đó hỏng với "The AI assistant is unavailable";
# task nền vẫn chạy vì routing giữ local. Lần deploy đầu bỏ sót đúng chỗ này.
#
# Hồ sơ ĐƯỢC che trước khi rời máy: chatUserPrompt luôn gọi redactProfileForModel
# cho mọi provider, và TestChatPromptNeverCarriesPIIToModelForV2 khoá điều đó lại.
#
# CẢNH BÁO còn lại: tin nhắn người dùng gõ và lịch sử hội thoại đi nguyên văn.
# Ai gõ số điện thoại thật vào khung chat thì số đó sang DeepSeek/OpenAI. Các cờ
# `never_send_raw_pii` và `redact_pii` trong config.yml vẫn KHÔNG code Go nào đọc
# — lớp che thật nằm trong chatUserPrompt, không nằm ở cấu hình.
# Để trống hai dòng dưới nếu muốn dữ liệu không rời máy.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ── Vị trí dữ liệu ──────────────────────────────────────────────────────────
# Chứa CV thật. Phải nằm trên volume có backup.
DATA_ROOT=/srv/hr-agent/data

# ── Publish cổng ────────────────────────────────────────────────────────────
# backend bind vào IP NetBird: chỉ peer trong mạng NetBird gọi được, không
# phải LAN 192.168.1.0/24 hay internet.
BACKEND_BIND=100.82.195.220
BACKEND_PORT=18090

# Ba service này chỉ backend/worker dùng, qua compose network. Bind loopback
# để không lộ ra ngoài máy. Cổng khác mặc định vì trên Server AI 5433, 6380,
# 8100 đều đã bị dịch vụ khác chiếm.
PG_BIND=127.0.0.1
PG_PORT=15433
REDIS_BIND=127.0.0.1
REDIS_PORT=16380
PDFKIT_BIND=127.0.0.1
PDFKIT_PORT=18100
